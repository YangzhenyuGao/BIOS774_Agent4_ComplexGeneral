# Runtime caches and local credentials
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.cache/
.venv/
.env
.env.*
*.env
*.pem
*.key
*credentials*.json
core
core.*

# Data, frozen features, weights and prediction arrays stay on the server.
/data/
/models/
/features/
/checkpoints/
/bench_private/
/outputs/*/agent_view/
/outputs/_smoke/
/outputs/_superseded/
*.npy
*.npz
*.parquet
*.h5
*.h5ad
*.h5mu
*.pt
*.pth
*.ckpt
*.safetensors
*.joblib
*.svs
*.tif
*.tiff
*.mtx
*.tmp

# Keep the final records and the two reviewed submission archives.
/logs/*
!/logs/llm_calls.jsonl
*.zip
!/submission/source_code.zip
!/submission/generated_outputs.zip
